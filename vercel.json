{
  "version": 2,
  "routes": [
    {
      "src": "^/_media_proxy/?$",
      "dest": "/api/proxy?path=_media_proxy"
    },
    {
      "src": "^/logs/?$",
      "dest": "/logs.html"
    },
    {
      "src": "^/$",
      "has": [
        {
          "type": "query",
          "key": "embed",
          "value": "1"
        }
      ],
      "dest": "/api/proxy?path=sec.html&embed=1"
    },
    {
      "src": "/cinejoy",
      "dest": "/api/proxy?path=sec.html&embed=1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/api/proxy?path=$1"
    }
  ]
}
